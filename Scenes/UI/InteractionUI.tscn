[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/interaction_ui.gd" id="1_interact"]
[ext_resource type="Theme" path="res://Scenes/UI/GameTheme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_interact"]
bg_color = Color(0.04, 0.035, 0.05, 0.85)
