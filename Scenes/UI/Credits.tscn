[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/credits.gd" id="1_credits"]
[ext_resource type="Theme" path="res://Scenes/UI/GameTheme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="Font_thai_title"]
font_names = PackedStringArray("Palatino Linotype", "Book Antiqua", "Georgia", "Segoe UI", "Serif")

[sub_resource type="SystemFont" id="Font_thai_body"]
font_names = PackedStringArray("Segoe UI", "Leelawadee UI", "Tahoma", "Sans-Serif")

[sub_resource type="FontVariation" id="FontVar_credits_title"]
base_font = SubResource("Font_thai_title")
spacing_glyph = 4

[sub_resource type="FontVariation" id="FontVar_credits_sub"]
base_font = SubResource("Font_thai_body")
spacing_glyph = 3

[sub_resource type="SystemFont" id="Font_sans_semibold"]
font_names = PackedStringArray("Segoe UI", "Helvetica Neue", "Arial", "Sans-Serif")
font_weight = 600

[sub_resource type="FontVariation" id="FontVar_menu"]
base_font = SubResource("Font_sans_semibold")
spacing_glyph = 3

[node name="Credits" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_credits")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.035, 0.05, 1)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ContentBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TitleBlock" type="VBoxContainer" parent="CenterContainer/ContentBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="CenterContainer/ContentBox/TitleBlock"]
