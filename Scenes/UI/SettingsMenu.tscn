[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/settings_menu.gd" id="1_settings"]
[ext_resource type="Theme" path="res://Scenes/UI/GameTheme.tres" id="2_theme"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
