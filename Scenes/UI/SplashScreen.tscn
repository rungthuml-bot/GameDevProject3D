[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/splash_screen.gd" id="1_splash"]
[ext_resource type="Theme" path="res://Scenes/UI/GameTheme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="Font_serif"]
font_names = PackedStringArray("Palatino Linotype", "Book Antiqua", "Georgia", "Times New Roman", "Serif")

[sub_resource type="SystemFont" id="Font_sans"]
font_names = PackedStringArray("Segoe UI", "Helvetica Neue", "Arial", "Sans-Serif")

[sub_resource type="FontVariation" id="FontVar_title"]
base_font = SubResource("Font_serif")
spacing_glyph = 5

[sub_resource type="FontVariation" id="FontVar_subtitle"]
base_font = SubResource("Font_sans")
spacing_glyph = 4

[node name="SplashScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_splash")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.03, 0.05, 1)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.88, 0.78, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.4)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 2
theme_override_fonts/font = SubResource("FontVar_title")
theme_override_font_sizes/font_size = 48
text = "DUNGEON MYSTERY MAZE"
horizontal_alignment = 1
vertical_alignment = 1

[node name="SubtitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.74, 0.62, 0.45, 1)
theme_override_fonts/font = SubResource("FontVar_subtitle")
theme_override_font_sizes/font_size = 13
text = "A JOURNEY INTO THE UNKNOWN"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Spacer" type="Control" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)

[node name="PromptLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.58, 0.51, 1)
theme_override_fonts/font = SubResource("FontVar_subtitle")
theme_override_font_sizes/font_size = 12
text = "PRESS ANY KEY TO ENTER"
horizontal_alignment = 1
vertical_alignment = 1

[node name="FadeRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)
