[gd_scene format=3 uid="uid://ending_cutscene_v1"]

[ext_resource type="Script" path="res://Scripts/UI/ending_cutscene.gd" id="1_cutscene"]
[ext_resource type="Theme" path="res://Scenes/UI/GameTheme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="Font_serif"]
font_names = PackedStringArray("Palatino Linotype", "Book Antiqua", "Georgia", "Serif")

[sub_resource type="SystemFont" id="Font_sans_semibold"]
font_names = PackedStringArray("Segoe UI", "Helvetica Neue", "Arial", "Sans-Serif")
font_weight = 600

[sub_resource type="FontVariation" id="FontVar_title"]
base_font = SubResource("Font_serif")
spacing_glyph = 6

[sub_resource type="FontVariation" id="FontVar_escaped"]
base_font = SubResource("Font_serif")
spacing_glyph = 4

[sub_resource type="FontVariation" id="FontVar_menu"]
base_font = SubResource("Font_sans_semibold")
spacing_glyph = 3

[sub_resource type="Environment" id="Environment_ending"]
background_mode = 0
background_color = Color(0.02, 0.015, 0.025, 1)
ambient_light_source = 1
ambient_light_color = Color(0.12, 0.09, 0.06, 1)
ambient_light_energy = 0.6

; =========================================================
; ROOT — EndingCutscene (Node3D so cinematic camera works in 3D)
; =========================================================

[node name="EndingCutscene" type="Node3D"]
script = ExtResource("1_cutscene")

; =========================================================
; 3D WORLD — Minimal dark environment
; =========================================================

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_ending")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, 0.433, -0.25, 0, 0.5, 0.866, 0.5, -0.75, 0.433, 0, 8, 0)
light_color = Color(0.9, 0.82, 0.65, 1)
light_energy = 0.8
shadow_enabled = true

; =========================================================
; CINEMATIC CAMERA
; =========================================================

[node name="CinematicCamera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.97, -0.24, 0, 0.24, 0.97, -3, 2.5, 6)
fov = 60.0
near = 0.05

; =========================================================
; EXIT MARKER — Where the player walks toward
; This should be replaced by the actual exit door position in the real level.
; =========================================================

[node name="ExitMarker3D" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -6)

; =========================================================
; CAMERA PATH — 3 waypoints for cinematic pan
; =========================================================

[node name="CameraPath" type="Node3D" parent="."]

[node name="CameraStart" type="Marker3D" parent="CameraPath"]
transform = Transform3D(1, 0, 0, 0, 0.97, -0.24, 0, 0.24, 0.97, -3, 2.5, 6)

[node name="CameraMid" type="Marker3D" parent="CameraPath"]
transform = Transform3D(1, 0, 0, 0, 0.97, -0.24, 0, 0.24, 0.97, 2, 3.5, 4)

[node name="CameraEnd" type="Marker3D" parent="CameraPath"]
transform = Transform3D(1, 0, 0, 0, 0.97, -0.24, 0, 0.24, 0.97, 0, 5, -2)

; =========================================================
; UI LAYER
; =========================================================

[node name="UILayer" type="CanvasLayer" parent="."]
layer = 10

[node name="FadeRect" type="ColorRect" parent="UILayer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="SkipHint" type="Label" parent="UILayer"]
layout_mode = 3
anchors_preset = 4
anchor_left = 0.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -50.0
offset_bottom = -16.0
grow_vertical = 0
